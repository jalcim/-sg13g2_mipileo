MACRO MIPI_Corner
  CLASS PAD SPACER ;
  FOREIGN MIPI_Corner ;
  ORIGIN 0.000 0.000 ;
  SIZE 180.000 BY 180.000 ;
  SYMMETRY X Y R90 ;
  SITE sg13g2_cornerSite ;
  PIN IOVSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER TopMetal1 ;
        RECT 7.000 65.500 32.500 180.000 ;
        POLYGON 32.500 75.700 42.700 65.500 32.500 65.500 ;
        POLYGON 7.000 65.500 40.000 65.500 40.000 32.500 ;
        RECT 40.000 32.500 42.700 65.500 ;
        POLYGON 42.700 65.500 75.700 32.500 42.700 32.500 ;
        POLYGON 40.000 32.500 65.500 32.500 65.500 7.000 ;
        RECT 65.500 7.000 180.000 32.500 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT 34.500 84.945 60.000 180.000 ;
        POLYGON 34.500 84.945 60.000 84.945 60.000 59.445 ;
        POLYGON 60.000 95.145 95.145 60.000 60.000 60.000 ;
        RECT 60.000 59.445 180.000 60.000 ;
        POLYGON 60.000 59.445 84.945 59.445 84.945 34.500 ;
        RECT 84.945 34.500 180.000 59.445 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT 126.000 144.275 134.000 180.000 ;
        POLYGON 126.000 144.275 128.800 144.275 128.800 141.475 ;
        RECT 128.800 141.475 134.000 144.275 ;
        POLYGON 134.000 147.475 140.000 141.475 134.000 141.475 ;
        POLYGON 128.800 141.475 136.275 141.475 136.275 134.000 ;
        RECT 136.275 134.000 140.000 141.475 ;
        POLYGON 140.000 141.475 147.475 134.000 140.000 134.000 ;
        POLYGON 136.275 134.000 144.275 134.000 144.275 126.000 ;
        RECT 144.275 126.000 180.000 134.000 ;
    END
    PORT
