    CLASS PAD ;
    SYMMETRY R90 ;
    SIZE 1.00 BY 180.00 ;
END sg13g2_ioSite

SITE sg13g2_cornerSite
    CLASS PAD ;
    SYMMETRY R90 ;
    SIZE 180.00 BY 180.00 ;
END sg13g2_cornerSite

MACRO MIPI_Filler200
  CLASS PAD SPACER ;
  FOREIGN MIPI_Filler200 ;
  ORIGIN 0.000 0.000 ;
  SIZE 1.000 BY 180.000 ;
  SYMMETRY X Y R90 ;
  SITE sg13g2_ioSite ;
  PIN IOVSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 7.000 1.340 32.500 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 34.500 1.340 60.000 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 126.000 1.340 134.000 ;
    END
    PORT
      LAYER TopMetal2 ;
        RECT -0.500 8.500 1.500 31.000 ;
    END
    PORT
      LAYER TopMetal2 ;
        RECT -0.500 36.000 1.500 58.500 ;
    END
    PORT
      LAYER TopMetal2 ;
        RECT -0.500 127.500 1.500 132.500 ;
    END
  END IOVSS
  PIN IOVDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 66.000 1.340 91.500 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 93.500 1.340 119.000 ;
    END
    PORT
      LAYER TopMetal2 ;
        RECT -0.500 67.500 1.500 90.000 ;
    END
    PORT
      LAYER TopMetal2 ;
        RECT -0.500 95.000 1.500 117.500 ;
    END
  END IOVDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 140.000 1.000 158.000 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 160.000 1.340 178.000 ;
    END
  END VSS
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 160.000 1.000 178.000 ;
    END
    PORT
      LAYER TopMetal1 ;
        RECT -0.340 140.000 1.340 158.000 ;
    END
  END VDD
  PIN POLN_RX
    DIRECTION INOUT ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 119.600 1.000 120.400 ;
    END
  END POLN_RX
  PIN VB
    DIRECTION INOUT ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 120.850 1.000 121.650 ;
    END
  END VB
  PIN PBIAS
    DIRECTION INOUT ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 122.100 1.000 122.900 ;
    END
  END PBIAS
  PIN PS
    DIRECTION INOUT ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 123.350 1.000 124.150 ;
    END
  END PS
  PIN POLN
    DIRECTION INOUT ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 124.600 1.000 125.400 ;
    END
  END POLN
  OBS
