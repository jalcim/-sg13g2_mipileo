        }
      }
    }
    pin (A) {
      direction : input;
      input_voltage : core;
      related_ground_pin : VSS;
      related_power_pin : VDD;
      max_transition : 2;
      capacitance : 0.011053;
      rise_capacitance : 0.0110567;
