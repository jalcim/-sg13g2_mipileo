/* MIPI_io_ff_bcs_m40 : IO LVCMOS 1,2 V du ring MIPI (MIPI_IOPadIn, MIPI_IOPadOut).
   Genere par 2_analog/LVCMOS12/lib/gen_mipi_io_lib.py le 2026-09-29 -- ne pas editer, relancer le script.
   Corner ff_bcs_m40 : VDD = IOVDD = 1.32 V, -40 degC. Delais et transitions simules ngspice sur les netlists
   schematiques (lvcmos12_schm_in.sp, lvcmos12_out.sp) + sg13g2_SecondaryProtection et DCN/DCP d'IHP, sans
   parasites de layout. Pas de puissance interne. */
library (MIPI_io_ff_bcs_m40) {
  comment : "MIPI D-PHY ring, IO LVCMOS 1.2 V, characterized ff_bcs_m40";
  date : "2026-09-29";
  revision : "0.1";
  delay_model : table_lookup;
  capacitive_load_unit (1,pf);
  current_unit : "1uA";
  leakage_power_unit : "1pW";
  pulling_resistance_unit : "1kohm";
  time_unit : "1ns";
  voltage_unit : "1V";
  default_cell_leakage_power : 0;
  default_fanout_load : 1;
  default_inout_pin_cap : 0;
  default_input_pin_cap : 0;
  default_output_pin_cap : 0;
  default_leakage_power_density : 0;
  default_max_transition : 5;
  in_place_swap_mode : match_footprint;
  input_threshold_pct_fall : 50;
  input_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  slew_lower_threshold_pct_fall : 10;
  slew_lower_threshold_pct_rise : 10;
  slew_upper_threshold_pct_fall : 90;
  slew_upper_threshold_pct_rise : 90;
  slew_derate_from_library : 1;
  nom_process : 1;
  nom_temperature : -40;
  nom_voltage : 1.32;
  voltage_map (VDD, 1.32);
  voltage_map (VSS, 0);
  voltage_map (IOVDD, 1.32);
  voltage_map (IOVSS, 0);
  operating_conditions (MIPI_io_ff_bcs_m40) {
    process : 1;
    temperature : -40;
    voltage : 1.32;
  }
  default_operating_conditions : MIPI_io_ff_bcs_m40;
  input_voltage (core) {
    vih : 1.32;
    vil : 0;
    vimax : 1.32;
    vimin : 0;
  }
  input_voltage (pad) {
    vih : 1.32;
    vil : 0;
    vimax : 1.32;
    vimin : 0;
  }
  output_voltage (core) {
    voh : 1.32;
    vol : 0;
    vomax : 1.32;
    vomin : 0;
  }
  output_voltage (pad) {
    voh : 1.32;
    vol : 0;
    vomax : 1.32;
    vomin : 0;
  }
  lu_table_template (in_delay_5x5) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.1, 0.3, 1, 2.5, 5");
    index_2 ("0.002, 0.005, 0.01, 0.03, 0.1");
  }
  lu_table_template (out_delay_5x5) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.02, 0.1, 0.3, 0.8, 2");
    index_2 ("1, 3, 8, 15, 30");
  }
  cell (MIPI_IOPadIn) {
    area : 14400;
    dont_touch : true;
    dont_use : true;
    cell_footprint : "input";
    pad_cell : true;
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : "VDD";
    }
    pg_pin (VSS) {
      pg_type : primary_ground;
      voltage_name : "VSS";
    }
    pg_pin (IOVDD) {
      pg_type : primary_power;
      voltage_name : "IOVDD";
    }
    pg_pin (IOVSS) {
      pg_type : primary_ground;
      voltage_name : "IOVSS";
    }
    leakage_power () {
      value : 384.523;
      when : "!PAD&!P2C";
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 15.6816;
      when : "!PAD&!P2C";
      related_pg_pin : IOVDD;
    }
    leakage_power () {
      value : 114.745;
      when : "PAD&P2C";
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 5.97681e-07;
      when : "PAD&P2C";
      related_pg_pin : IOVDD;
    }
    leakage_power () {
      value : 249.634;
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 7.8408;
      related_pg_pin : IOVDD;
    }
    pin (P2C) {
      direction : output;
