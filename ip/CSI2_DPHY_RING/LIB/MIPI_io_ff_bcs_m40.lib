          values ( \
            "0.0969942, 0.248732, 0.630683, 1.16713, 2.31866", \
            "0.0971598, 0.248776, 0.630685, 1.16713, 2.31865", \
            "0.0985266, 0.249413, 0.630717, 1.16709, 2.31864", \
