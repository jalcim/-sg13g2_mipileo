          values ( \
            "0.119246, 0.125958, 0.134586, 0.160546, 0.236533", \
            "0.202396, 0.209159, 0.217864, 0.243979, 0.319853", \
            "0.43614, 0.444991, 0.454655, 0.483153, 0.56092", \
