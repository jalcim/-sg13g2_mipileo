    }
    leakage_power () {
      value : 291.589;
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 12456.8;
      related_pg_pin : IOVDD;
    }
    pin (PAD) {
      direction : output;
      function : "A";
      is_pad : true;
      drive_current : 4000;
      output_voltage : pad;
      related_ground_pin : IOVSS;
      related_power_pin : IOVDD;
      max_capacitance : 30;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (out_delay_5x5) {
          index_1 ("0.02, 0.1, 0.3, 0.8, 2");
          index_2 ("1, 3, 8, 15, 30");
          values ( \
