            "0.0513249, 0.0597149, 0.0670658, 0.102229, 0.236237" \
          );
        }
      }
    }
    pin (PAD) {
      direction : input;
      is_pad : true;
      input_voltage : pad;
      related_ground_pin : IOVSS;
      related_power_pin : IOVDD;
      max_transition : 5;
      capacitance : 0.116539;
      rise_capacitance : 0.116608;
      fall_capacitance : 0.116471;
    }
  }
  cell (MIPI_IOPadOut) {
    area : 14400;
    dont_touch : true;
    dont_use : true;
    cell_footprint : "output";
    pad_cell : true;
    pg_pin (VDD) {
      pg_type : primary_power;
      voltage_name : "VDD";
    }
    pg_pin (VSS) {
      pg_type : primary_ground;
      voltage_name : "VSS";
    }
    pg_pin (IOVDD) {
      pg_type : primary_power;
      voltage_name : "IOVDD";
    }
    pg_pin (IOVSS) {
      pg_type : primary_ground;
      voltage_name : "IOVSS";
    }
    leakage_power () {
      value : 539.358;
      when : "!A&!PAD";
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 13653;
      when : "!A&!PAD";
      related_pg_pin : IOVDD;
    }
    leakage_power () {
      value : 43.8194;
      when : "A&PAD";
      related_pg_pin : VDD;
    }
    leakage_power () {
      value : 11260.6;
      when : "A&PAD";
