  operating_conditions (MIPI_io_tt_typ_25) {
    process : 1;
    temperature : 25;
    voltage : 1.2;
  }
  default_operating_conditions : MIPI_io_tt_typ_25;
  input_voltage (core) {
    vih : 1.2;
    vil : 0;
    vimax : 1.2;
    vimin : 0;
  }
  input_voltage (pad) {
    vih : 1.2;
    vil : 0;
    vimax : 1.2;
    vimin : 0;
  }
  output_voltage (core) {
    voh : 1.2;
    vol : 0;
    vomax : 1.2;
    vomin : 0;
  }
  output_voltage (pad) {
    voh : 1.2;
    vol : 0;
    vomax : 1.2;
    vomin : 0;
  }
  lu_table_template (in_delay_5x5) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.1, 0.3, 1, 2.5, 5");
    index_2 ("0.002, 0.005, 0.01, 0.03, 0.1");
  }
  lu_table_template (out_delay_5x5) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.02, 0.1, 0.3, 0.8, 2");
    index_2 ("1, 3, 8, 15, 30");
  }
