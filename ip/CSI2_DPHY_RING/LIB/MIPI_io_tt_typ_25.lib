/* MIPI_io_tt_typ_25 : IO LVCMOS 1,2 V du ring MIPI (MIPI_IOPadIn, MIPI_IOPadOut).
   Genere par 2_analog/LVCMOS12/lib/gen_mipi_io_lib.py le 2026-09-29 -- ne pas editer, relancer le script.
   Corner tt_typ_25 : VDD = IOVDD = 1.2 V, 25 degC. Delais et transitions simules ngspice sur les netlists
   schematiques (lvcmos12_schm_in.sp, lvcmos12_out.sp) + sg13g2_SecondaryProtection et DCN/DCP d'IHP, sans
   parasites de layout. Pas de puissance interne. */
library (MIPI_io_tt_typ_25) {
  comment : "MIPI D-PHY ring, IO LVCMOS 1.2 V, characterized tt_typ_25";
  date : "2026-09-29";
  revision : "0.1";
  delay_model : table_lookup;
  capacitive_load_unit (1,pf);
  current_unit : "1uA";
  leakage_power_unit : "1pW";
  pulling_resistance_unit : "1kohm";
  time_unit : "1ns";
  voltage_unit : "1V";
  default_cell_leakage_power : 0;
  default_fanout_load : 1;
