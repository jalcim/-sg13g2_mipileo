library (MIPI_ring_dummy) {
    delay_model : table_lookup;
    capacitive_load_unit (1,ff);
    current_unit : "1mA";
    leakage_power_unit : "1mW";
    pulling_resistance_unit : "1kohm";
    time_unit : "1ps";
    voltage_unit : "1V";
    voltage_map (VDD, 1.2);
    voltage_map (VSS, 0.0);
    voltage_map (IOVDD, 1.2);
    voltage_map (IOVSS, 0.0);
    voltage_map (IOVDD_MIPI, 1.2);
    voltage_map (IOVSS_MIPI, 0.0);
    voltage_map (IOVDD33, 3.3);
    default_cell_leakage_power : 0;
    default_inout_pin_cap : 1;
    default_input_pin_cap : 1;
    default_output_pin_cap : 0;
    default_max_transition : 5000;
    in_place_swap_mode : match_footprint;
    input_threshold_pct_fall : 50;
    input_threshold_pct_rise : 50;
    output_threshold_pct_fall : 50;
    output_threshold_pct_rise : 50;
    slew_lower_threshold_pct_fall : 20;
    slew_lower_threshold_pct_rise : 20;
    slew_upper_threshold_pct_fall : 80;
    slew_upper_threshold_pct_rise : 80;
    slew_derate_from_library : 1;
    nom_process : 1;
    nom_temperature : 25;
    nom_voltage : 1.2;
    operating_conditions ("typ") {
        process : 1;
        temperature : 25;
        voltage : 1.2;
        tree_type : "balanced_tree";
    }
    default_operating_conditions : "typ";
